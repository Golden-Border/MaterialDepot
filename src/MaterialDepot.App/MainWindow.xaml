<Window x:Class="MaterialDepot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:MaterialDepot.App.Resources"
        xmlns:views="clr-namespace:MaterialDepot.App.Views"
        xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Material Depot" Icon="Assets/MaterialDepot.ico" Width="1360" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Activated="OnActivated">
    <TabControl Margin="8" Padding="0" BorderThickness="0" Background="Transparent">
        <TabItem Header="{x:Static res:Strings.Main_LibraryTab}" Padding="14,6">
            <views:LibraryView DataContext="{Binding Library}" />
        </TabItem>
        <TabItem Padding="14,6" AutomationProperties.Name="{x:Static res:Strings.Main_InboxTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.Main_InboxTab}" />
                    <Border Background="{StaticResource Accent}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                            Visibility="{Binding Inbox.NewCount, Converter={StaticResource Presence}}">
                        <TextBlock Text="{Binding Inbox.NewCount}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </TabItem.Header>
            <views:InboxView DataContext="{Binding Inbox}" />
        </TabItem>
        <TabItem Header="{x:Static res:Strings.Main_SettingsTab}" Padding="14,6">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
