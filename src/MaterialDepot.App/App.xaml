<Application x:Class="MaterialDepot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaterialDepot.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <local:PresenceToVisibilityConverter x:Key="Presence" />
        <local:NegationConverter x:Key="Not" />

        <SolidColorBrush x:Key="WindowBackground" Color="#F3F2EF" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#DDDAD3" />
        <SolidColorBrush x:Key="Accent" Color="#8A4B22" />
        <SolidColorBrush x:Key="AccentSoft" Color="#F1E2D6" />
        <SolidColorBrush x:Key="Muted" Color="#77736B" />
        <SolidColorBrush x:Key="Success" Color="#2F6B3A" />
        <SolidColorBrush x:Key="SuccessSoft" Color="#DCEBDD" />
        <SolidColorBrush x:Key="Warning" Color="#9A5B00" />
        <SolidColorBrush x:Key="Placeholder" Color="#E6E3DC" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <!-- One map a set brings, as a small chip. -->
        <DataTemplate x:Key="MapChip">
            <Border Background="{StaticResource AccentSoft}" CornerRadius="3" Padding="5,1" Margin="0,0,4,4">
                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource Accent}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ChipPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Application.Resources>
</Application>
