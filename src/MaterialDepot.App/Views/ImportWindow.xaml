<Window x:Class="MaterialDepot.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
        Title="In Projekt übernehmen" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="150" Height="150" VerticalAlignment="Top" Background="{StaticResource Placeholder}" CornerRadius="4">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                        <Setter Property="Margin" Value="0,0,12,6" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,10" Style="{StaticResource Heading}">
                    <Run Text="{Binding Set.Name, Mode=OneWay}" /><Run Text=" → " Foreground="{StaticResource Muted}" /><Run Text="{Binding Project.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Row="1" Text="Materialname" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Material-Ordner" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaterialDirectory, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Relativ zum Asset-Ordner des Projekts" />
                <TextBlock Grid.Row="3" Text="Texturordner" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TextureFolderName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Unterordner für die PNGs und die .sdtex; üblich ist der Produktname des Sets" />

                <TextBlock Grid.Row="4" Text="Kachelgröße (m, optional)" />
                <TextBox Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding TileSizeText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="5" Grid.Column="1">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Foreground="{StaticResource Accent}"
                               Text="{Binding TileSizeFromName}" Visibility="{Binding TileSizeFromName, Converter={StaticResource Presence}}" />
                    <TextBlock Style="{StaticResource Hint}"
                           Text="Nur ausfüllen, wenn die Textur in echter Größe liegen soll; textures.com gibt sie an, 20 × 20 cm ist 0,2. Echte Größe kann aus der Spielkamera zu fein wirken: Heavy Rust 3 auf Schlüssel und Schloss sah bei 2,5 nur noch braun aus, mit 1 stimmt es." />
                </StackPanel>
                <TextBlock Grid.Row="6" Text="Meter pro UV-Einheit" />
                <TextBox Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding MetersPerUvUnitText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}"
                           Text="Wie viel Fläche eine UV-Einheit auf den Meshes abdeckt: z. B. 1 für Wände und Böden, 0,5 für kleine Props." />
                <TextBlock Grid.Row="8" Text="UVScale" />
                <TextBox Grid.Row="8" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding UvScaleText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Standard 1; mit einer Kachelgröße errechnet aus den beiden Feldern darüber" />
                <TextBlock Grid.Row="9" Text="Material-Id (optional)" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MaterialIdText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Nur nötig, wenn Modelle schon eine Material-Id erwarten, die es noch nicht gibt" />
                <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource Hint}" Foreground="{StaticResource Warning}"
                           Text="{Binding MaterialNote}" Visibility="{Binding MaterialNote, Converter={StaticResource Presence}}" />
            </Grid>
        </Grid>

        <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource SuccessSoft}" CornerRadius="4"
                Visibility="{Binding Result, Converter={StaticResource Presence}}">
            <StackPanel>
                <TextBlock Foreground="{StaticResource Success}" FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="Fertig. Game Studio liest geänderte Dateien nicht von selbst neu ein: Projekt neu laden." />
                </TextBlock>
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Result.WrittenFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Wird übernommen …" Style="{StaticResource MutedText}"
                       Visibility="{Binding IsImporting, Converter={StaticResource Presence}}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Übernehmen" Command="{Binding ImportCommand}" IsDefault="True" />
            <Button Margin="8,0,0,0" Content="Schließen" Command="{Binding CloseCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
