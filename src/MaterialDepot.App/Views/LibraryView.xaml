<UserControl x:Class="MaterialDepot.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MaterialDepot.App.Resources"
             xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}">
    <Grid Margin="4,10,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.Library_Search}" Style="{StaticResource FieldLabel}" />
            <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.Library_Project}" Margin="20,0,12,0" VerticalAlignment="Center" />
            <ComboBox DockPanel.Dock="Left" Width="180" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" />
            <Button DockPanel.Dock="Left" Margin="12,0,0,0" Content="{x:Static res:Strings.Library_Rescan}" Command="{Binding RescanCommand}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1" CornerRadius="6" Padding="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Muted}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Frame" Property="Padding" Value="7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TextureSetCardViewModel}">
                    <StackPanel Width="168" Background="Transparent">
                        <StackPanel.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </StackPanel.InputBindings>
                        <Grid Width="168" Height="168">
                            <Border Background="{StaticResource Placeholder}" CornerRadius="3">
                                <TextBlock Text="{Binding PlaceholderText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                            </Border>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="3"
                                    Background="#B0000000" Visibility="{Binding Resolution, Converter={StaticResource Presence}}">
                                <TextBlock Text="{Binding Resolution}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="3"
                                    Background="{StaticResource SuccessSoft}" Visibility="{Binding IsInProject, Converter={StaticResource Presence}}">
                                <TextBlock Text="{x:Static res:Strings.Library_InProject}" Foreground="{StaticResource Success}" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="5,1" CornerRadius="3"
                                    Background="#B0000000" Visibility="{Binding HasCloudOnlyMaps, Converter={StaticResource Presence}}"
                                    ToolTip="{x:Static res:Strings.Library_CloudToolTip}">
                                <TextBlock Text="{x:Static res:Strings.Library_CloudBadge}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" ToolTip="{Binding Location}" />
                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Maps}" ItemTemplate="{StaticResource MapChip}" ItemsPanel="{StaticResource ChipPanel}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <TextBlock Text="{x:Static res:Strings.Library_NoSelection}"
                           TextWrapping="Wrap" Style="{StaticResource Hint}"
                           Visibility="{Binding SelectedSet, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                <StackPanel DataContext="{Binding SelectedSet}" Visibility="{Binding Converter={StaticResource Presence}}">
                    <Border Background="{StaticResource Placeholder}" CornerRadius="4" Height="310">
                        <Grid>
                            <TextBlock Text="{Binding PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,2" Text="{Binding Name}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Maps}" ItemTemplate="{StaticResource MapChip}" ItemsPanel="{StaticResource ChipPanel}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Set.Maps.Values}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Stem}" Style="{StaticResource MutedText}" ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Library_Import}" AutomationProperties.AutomationId="ImportButton"
                                Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Library_OpenFolder}"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Library_MissingMaps}"
                               Visibility="{Binding CanImport, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Library_CloudHint}"
                               Visibility="{Binding HasCloudOnlyMaps, Converter={StaticResource Presence}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
