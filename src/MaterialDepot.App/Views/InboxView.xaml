<UserControl x:Class="MaterialDepot.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}">
    <DockPanel Margin="4,10,4,4">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Downloads neu einlesen" Command="{Binding RescanCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="14,0,0,0" Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="12.5" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0" Text="{Binding LastAction}" Foreground="{StaticResource Success}"
                       Visibility="{Binding LastAction, Converter={StaticResource Presence}}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Hint}"
                       Text="Kopieren lässt die Downloads liegen, Verschieben legt sie danach in den Papierkorb. Eine Datei, die mit anderem Inhalt schon in der Bibliothek liegt, wird nie überschrieben." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Candidates}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadCandidateViewModel}">
                        <Border Margin="0,0,0,10" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="112" Background="{StaticResource Placeholder}" CornerRadius="3">
                                    <Grid>
                                        <TextBlock Text="{Binding PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                    <TextBlock Text="{Binding BaseName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Origin}" Style="{StaticResource MutedText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Size}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Resolution}" Margin="10,0,0,0" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Status}" Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource Warning}" />
                                    </StackPanel>
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Maps}" ItemTemplate="{StaticResource MapChip}" ItemsPanel="{StaticResource ChipPanel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Set-Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Width="300" Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Ordner in der Bibliothek; am besten der Produktname von textures.com" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Verschieben"
                                            Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Margin="0,6,0,0" Content="Kopieren"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
