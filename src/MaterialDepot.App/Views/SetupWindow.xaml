<Window x:Class="MaterialDepot.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:MaterialDepot.App.Resources"
        xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
        Title="{x:Static res:Strings.Setup_Title}" Width="680" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static res:Strings.Setup_Welcome}" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Hint}" Margin="0,2,0,12" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{x:Static res:Strings.Setup_Skip}" Command="{Binding SkipCommand}" IsCancel="True"
                    ToolTip="{x:Static res:Strings.Setup_SkipToolTip}" />
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Setup_Finish}"
                    Command="{Binding FinishCommand}" IsDefault="True"
                    Visibility="{Binding IsLastStep, Converter={StaticResource Presence}}" />
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Setup_Next}"
                    Command="{Binding NextCommand}" IsDefault="True"
                    Visibility="{Binding IsLastStep, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Setup_Back}" Command="{Binding BackCommand}"
                    Visibility="{Binding IsNotFirstStep, Converter={StaticResource Presence}}" />
        </DockPanel>

        <Grid>
            <StackPanel Visibility="{Binding IsLibraryStep, Converter={StaticResource Presence}}">
                <TextBlock TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Setup_LibraryIntro}" />
                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseLibraryCommand}" />
                    <TextBox Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding LibraryNote}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsDownloadsStep, Converter={StaticResource Presence}}">
                <TextBlock TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Setup_DownloadsIntro}" />
                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseDownloadsCommand}" />
                    <TextBox Text="{Binding DownloadsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding DownloadsNote}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsProjectStep, Converter={StaticResource Presence}}">
                <TextBlock TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Setup_ProjectIntro}" />
                <CheckBox Margin="0,10,0,0" Content="{x:Static res:Strings.Setup_AddProject}" IsChecked="{Binding AddProject}" />
                <Grid Margin="0,10,0,0" IsEnabled="{Binding AddProject}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                            <Setter Property="Margin" Value="0,0,12,6" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Text="{x:Static res:Strings.Common_ProjectFolder}" />
                    <TextBox Grid.Column="1" Text="{Binding ProjectRootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Margin="8,0,0,6" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseProjectCommand}" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Common_Name}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Common_SourceImages}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProjectSourceTextureDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static res:Strings.Setup_SourceImagesToolTip}" />
                    <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Common_AssetFolder}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProjectAssetsDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static res:Strings.Setup_AssetFolderToolTip}" />
                    <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Common_Textures}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProjectTextureAssetDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static res:Strings.Common_RelativeToAssetFolder}" />
                    <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Common_Materials}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProjectMaterialDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static res:Strings.Common_RelativeToAssetFolder}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Warning}" Text="{Binding ProjectNote}"
                           Visibility="{Binding ProjectNote, Converter={StaticResource Presence}}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsFlowStep, Converter={StaticResource Presence}}">
                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Setup_FlowIntro}" />
                <ItemsControl Margin="0,10,0,0">
                    <ItemsControl.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ItemsControl.Resources>
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Setup_Flow1Title}" /><Run Text="{x:Static res:Strings.Setup_Flow1}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Setup_Flow2Title}" /><Run Text="{x:Static res:Strings.Setup_Flow2}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Setup_Flow3Title}" /><Run Text="{x:Static res:Strings.Setup_Flow3}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Setup_Flow4Title}" /><Run Text="{x:Static res:Strings.Setup_Flow4}" />
                    </TextBlock>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Setup_ReopenHint}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
