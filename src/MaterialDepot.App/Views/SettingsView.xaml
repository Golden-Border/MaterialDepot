<UserControl x:Class="MaterialDepot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MaterialDepot.App.Resources"
             xmlns:vm="clr-namespace:MaterialDepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,14,4,4" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.Settings_Folders}" Style="{StaticResource Heading}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Strings.Settings_Library}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseLibraryCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Text="{x:Static res:Strings.Settings_LibraryHint}" />
                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Settings_Downloads}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DownloadsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseDownloadsCommand}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Text="{x:Static res:Strings.Settings_DownloadsHint}" />
            </Grid>

            <TextBlock Margin="0,18,0,0" Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource Heading}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{x:Static res:Strings.Settings_Language}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Text="{x:Static res:Strings.Settings_LanguageHint}" />
            </Grid>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.Settings_FileNames}" Style="{StaticResource Heading}" />
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_RestoreDefaults}" Command="{Binding RestoreDefaultNamingCommand}" />
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Settings_AddPattern}" Command="{Binding AddPatternCommand}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.Settings_PatternsHint}" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Patterns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Remove}"
                                        Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBox DockPanel.Dock="Left" Width="200" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.Settings_PatternNameToolTip}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox FontFamily="Consolas" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Foreground="{StaticResource Warning}" TextWrapping="Wrap" Text="{Binding Error}"
                                       Visibility="{Binding Error, Converter={StaticResource Presence}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,10,0,0" Text="{x:Static res:Strings.Settings_MapNames}" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.Settings_MapNamesHint}" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding MapNames}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Strings.Settings_TestFileName}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Text="{Binding TestFileName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding TestResult}" />
            </Grid>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.Settings_StrideProjects}" Style="{StaticResource Heading}" />
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Remove}" Command="{Binding RemoveProjectCommand}" />
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Settings_AddProject}" Command="{Binding AddProjectCommand}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static res:Strings.Settings_ProjectsHint}" />
            <ListBox Margin="0,6,0,0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                     DisplayMemberPath="Name" MinHeight="60" MaxHeight="140" />

            <Grid Margin="0,10,0,0" DataContext="{Binding SelectedProject}" Visibility="{Binding Converter={StaticResource Presence}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                        <Setter Property="Margin" Value="0,0,12,6" />
                    </Style>
                </Grid.Resources>
                <TextBlock Text="{x:Static res:Strings.Common_Name}" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Common_ProjectFolder}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,6" Content="{x:Static res:Strings.Common_Browse}"
                        Command="{Binding DataContext.BrowseProjectRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Common_SourceImages}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SourceTextureDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Common_AssetFolder}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AssetsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Common_Textures}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TextureAssetDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Common_Materials}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaterialDirectory, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Settings_Save}" Command="{Binding SaveCommand}" />
                <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_Discard}" Command="{Binding ResetCommand}" />
                <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_Setup}" Command="{Binding RunSetupCommand}"
                        ToolTip="{x:Static res:Strings.Settings_SetupToolTip}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding SavedNote}" Foreground="{StaticResource Success}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ErrorNote}" Foreground="{StaticResource Warning}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
